#!/usr/bin/env python3
"""Entry point for consult. Works when symlinked from anywhere."""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("consult needs Python 3.11 or newer (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(2)

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from ai_rubric.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
